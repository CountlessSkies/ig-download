{
  "manifest_version": 3,
  "name": "Instagram Downloader Minimal",
  "version": "0.2.0",
  "description": "Download Instagram images, videos, reels, and stories with a username filename prefix.",
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://i.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*"
  ],
  "content_scripts": [{
    "matches": ["https://www.instagram.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": { "default_title": "Instagram Image Downloader" }
}
